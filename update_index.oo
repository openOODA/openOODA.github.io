// # Landing page index updater
//
// Logline: Update navigation, sections, and safety tables in the GitHub Pages index.html.
//
// Setup: FsReadCap and FsWriteCap granted to read and write index.html.
//
// Beats:
//   1. Resolve path to index.html and load content.
//   2. Update navigation links to point to Overview, Safety, and Install.
//   3. Rename Design section to Overview.
//   4. Replace legacy PM and Sprint sections with Safety by Construction table.
//   5. Write modified HTML to disk and report status.

pub fn str_replace_first(s: String, old_s: String, new_s: String) -> String {
    let idx = str_index_of(s, old_s);
    if idx < 0 {
        return s;
    }
    let prefix = str_slice(s, 0, idx);
    let suffix = str_slice(s, idx + chars_len(old_s), chars_len(s));
    return prefix + new_s + suffix;
}

pub fn get_old_nav() -> String {
    let mut s = "    <nav>\n";
    s = s + "      <a href=\"#design\">Design</a>\n";
    s = s + "      <a href=\"#pm\">PM status</a>\n";
    s = s + "      <a href=\"#sprint\">Sprint</a>\n";
    s = s + "      <a href=\"#install\">Install</a>\n";
    s = s + "      <a href=\"research.html\">Research Hub</a>\n";
    s = s + "      <a href=\"https://github.com/openOODA/openOODA/blob/main/DESIGN.oot\" target=\"_blank\" rel=\"noopener\">DESIGN.oot</a>\n";
    s = s + "      <a href=\"https://github.com/openOODA/ooda\" class=\"btn-primary\" target=\"_blank\" rel=\"noopener\">GitHub</a>\n";
    s = s + "    </nav>";
    return s;
}

pub fn get_new_nav() -> String {
    let mut s = "    <nav>\n";
    s = s + "      <a href=\"#overview\">Overview</a>\n";
    s = s + "      <a href=\"#safety\">Safety</a>\n";
    s = s + "      <a href=\"#install\">Install</a>\n";
    s = s + "      <a href=\"research.html\">Research Hub</a>\n";
    s = s + "      <a href=\"https://github.com/openOODA/ooda\" class=\"btn-primary\" target=\"_blank\" rel=\"noopener\">GitHub</a>\n";
    s = s + "    </nav>";
    return s;
}

pub fn get_safety_section() -> String {
    let mut s = "\n  <!-- Safety -->\n";
    s = s + "  <section class=\"progress-section\" id=\"safety\">\n";
    s = s + "    <div class=\"why-header\">\n";
    s = s + "      <h2>Safety by Construction</h2>\n";
    s = s + "      <p>openOODA enforces mathematical contracts and capability-based security at the compiler level.</p>\n";
    s = s + "    </div>\n\n";
    s = s + "    <div class=\"status-table-wrap\">\n";
    s = s + "      <h3 class=\"table-title\">Core Security Features</h3>\n";
    s = s + "      <table class=\"status-table\">\n";
    s = s + "        <thead><tr><th>Feature</th><th>Description</th></tr></thead>\n";
    s = s + "        <tbody>\n";
    s = s + "          <tr><td><strong>Capability Sandboxing</strong></td><td>Default-deny I/O. File system and network access require explicit <code>FsCap</code> and <code>NetCap</code> tokens.</td></tr>\n";
    s = s + "          <tr><td><strong>Memory Quotas</strong></td><td>Heap allocations are strictly bounded to prevent out-of-memory denial of service.</td></tr>\n";
    s = s + "          <tr><td><strong>Mathematical Contracts</strong></td><td><code>requires</code> and <code>ensures</code> clauses are enforced by the compiler.</td></tr>\n";
    s = s + "          <tr><td><strong>Zero Millisecond GC</strong></td><td>ARC memory management guarantees leak-free execution without pause times.</td></tr>\n";
    s = s + "        </tbody>\n";
    s = s + "      </table>\n";
    s = s + "    </div>\n";
    s = s + "  </section>\n";
    return s;
}

pub fn main(fsR: &FsReadCap, fsW: &FsWriteCap) {
    let path = if path_exists(fsR, "openOODA.github.io/index.html") {
        "openOODA.github.io/index.html"
    } else if path_exists(fsR, "index.html") {
        "index.html"
    } else {
        "/home/jeryd/Projects/openOODA/openOODA.github.io/index.html"
    };

    let read_res = read_file(fsR, path);
    let mut html = match read_res {
        Ok(s) => s,
        Err(_) => ""
    };

    if chars_len(html) == 0 {
        println("Error: unable to read " + path);
        process_exit(1);
    }

    // 1. Update navigation
    html = str_replace_first(html, get_old_nav(), get_new_nav());

    // 2. Rename Design to Overview
    html = str_replace_first(html, "<section class=\"design-section\" id=\"design\">", "<section class=\"design-section\" id=\"overview\">");
    html = str_replace_first(html, "<h2>Design goals <span class=\"section-tag\">DESIGN.oot</span></h2>", "<h2>Overview</h2>");
    html = str_replace_first(html, "<p>North star architecture — what openOODA is <em>for</em>. Goals are not claims of full implementation.</p>", "<p>A high-level look at the core mechanics and philosophy behind openOODA.</p>");

    // 3. Replace PM and Sprint sections with Safety section
    let start_anchor = "  <!-- PM.oot -->";
    let end_anchor = "  <section class=\"get-started\">";
    let start_idx = str_index_of(html, start_anchor);
    let end_idx = str_index_of(html, end_anchor);

    if start_idx >= 0 && end_idx >= 0 {
        let prefix = str_slice(html, 0, start_idx);
        let suffix = str_slice(html, end_idx, chars_len(html));
        html = prefix + get_safety_section() + suffix;
    }

    let write_res: Result[Void, String] = write_file(fsW, path, html);
    let _ = write_res;
    println("Updated index.html successfully.");
    process_exit(0);
}
